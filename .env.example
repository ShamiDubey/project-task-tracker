# Copy to .env and fill in. NEVER commit .env.

# Neon pooled connection string (Neon console -> Connection Details -> Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-plus-random-bytes"

# The company's working day, used to decide what counts as overdue. Defaults to UTC.
# Set it to the team's timezone so "overdue" means the same thing to everyone, regardless of
# where the app happens to be deployed. e.g. Europe/London, Asia/Kolkata
BUSINESS_TIMEZONE="UTC"
