# Copy to .env.local and fill in. NEVER commit .env.local.

# Neon pooled connection string (Neon console -> Connection Details -> Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-plus-random-bytes"
